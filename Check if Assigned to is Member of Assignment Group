// Function to check if a user is a member of a group
function isUserInGroup(userId, groupId) {
    var userGrp = new GlideRecord('sys_user_grmember');
    userGrp.addQuery('user', userId);
    userGrp.addQuery('group', groupId);
    userGrp.query();
    return userGrp.hasNext();
}
